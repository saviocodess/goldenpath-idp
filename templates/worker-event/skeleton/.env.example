SERVICE_NAME=worker-event
NODE_ENV=development
LOG_LEVEL=info
MAX_RETRIES=3
BASE_BACKOFF_MS=250
MAX_BACKOFF_MS=5000
BACKOFF_JITTER_RATIO=0.1
