{
  "name": "worker-event-template",
  "version": "0.1.0",
  "private": true,
  "description": "Skeleton de Golden Path para worker assíncrono Node.js + TypeScript",
  "scripts": {
    "dev": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
